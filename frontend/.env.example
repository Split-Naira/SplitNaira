NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Address of the deployed SplitNaira contract (C..., 56 chars). Optional: when unset
# the app still loads and logs a warning. A malformed value fails validation.
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# Must be a public URL in deployed environments; localhost only works on your machine.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Error monitoring (optional — leave blank to disable Sentry in the browser)
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_SCRUB_WALLET_ADDRESSES=true
NEXT_PUBLIC_TX_POLL_TIMEOUT=90
